+# ════════════════════════════════════════════
#   CampusBot Pro — Environment Variables
#   Copy this file to .env and fill in values
# ════════════════════════════════════════════

# ─── Server ─────────────────────────────────
PORT=5002
NODE_ENV=development        # change to: production on Render

# ─── MongoDB Atlas (Free M0 Cluster) ────────
# Get it: https://mongodb.com/atlas → Connect → Drivers
#MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/campusbot?retryWrites=true&w=majority

MONGO_URI=mongodb: hare you have to add your mangodb URL



# ─── Google Gemini API ────────────────────────────
# Get free key → https://makersuite.google.com/app/apikey
#npm install @google/generative-ai
GEMINI_API_KEY= Hare you have to add your gemini api key



# ─── CORS: Your deployed frontend URL ────────
# Set this AFTER deploying to Vercel
# Example: https://campusbot-pro.vercel.app
CLIENT_URL=https://campusproai.vercel.app/

# ─── Frontend (Vite reads VITE_ prefix) ──────
# Set this AFTER deploying backend to Render
# Example: https://campusbot-pro-server.onrender.com
VITE_API_BASE_URL=https://campuspro-ai-bot.onrender.com/  
